# Git and local-only files
.git
.gitignore
.github
.env
.env.*
!.env.example
.DS_Store

# Python environments and caches
.venv
__pycache__
*.py[cod]
.mypy_cache
.pytest_cache
.ruff_cache
*.egg-info

# Runtime artifacts
data
index-artifact

# Tests, docs, examples are not needed in the runtime image
tests
docs
examples
scripts

# Keep the README because the wheel metadata references it
*.md
!README.md

# Editors
.idea
.vscode
