# ---- App ----
APP_ENV=development
APP_PORT=8090
APP_BASE_URL=http://127.0.0.1:8090
LOG_LEVEL=info
REQUEST_TIMEOUT_SECONDS=60
CHAT_BIND_ADDR=127.0.0.1

# ---- Auth (reuse main-node PERSONALITY_AUTH_JWT_SECRET in production) ----
# Leave empty in dev: accepts `mock:<uid>` bearer tokens for local testing.
AUTH_JWT_SECRET=
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_ISSUER=personality-matrix
AUTH_JWT_AUDIENCE=
# Optional internal service token for VPC-only direct calls (never sent to browsers)
INTERNAL_SERVICE_TOKEN=

# ---- Go report API ----
# Empty = mock mode (returns a fixed INFP report for logged-in users).
# Production: http://127.0.0.1:8082 (systemd) or the main node private IP.
PERSONALITY_API_BASE_URL=
PERSONALITY_API_TIMEOUT_SECONDS=3

# ---- Database ----
# Empty + empty MYSQL_HOST => sqlite+aiosqlite:///./data/persona_chat.db (dev default)
DATABASE_URL=
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=personality
MYSQL_USER=persona_chat
MYSQL_PASSWORD=
# 仅 docker-compose.local.yml 的 mysql 容器需要（root 账号密码）
MYSQL_ROOT_PASSWORD=
# true = create tables at startup (dev). Production: false + `alembic upgrade head`
DB_AUTO_CREATE=true

# ---- Chroma / index ----
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=kb_mock_0000
INDEX_SNAPSHOT_ID=mock_0001
CATALOG_PATH=
INDEX_MANIFEST_PATH=
INDEX_ARTIFACT_DIR=

# ---- Embedding (build and query must use the same model) ----
# mock | ollama | openai_compatible
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
EMBEDDING_API_BASE=http://127.0.0.1:11434
EMBEDDING_API_KEY=

# ---- RAG ----
RAG_TOP_K=6
RAG_CANDIDATE_K=12
RAG_SCORE_THRESHOLD=0.35
RAG_MAX_PER_DOC=2
RAG_MAX_SOURCES=3
RAG_LOCALE_BOOST=0.03
CONTENT_SNAPSHOT_DIR=

# ---- LLM ----
# mock | litellm (install with: uv sync --extra llm)
LLM_PROVIDER=mock
LLM_ROUTER_MODEL=ollama/qwen2.5:3b-instruct
LLM_ANSWER_MODEL=ollama/qwen2.5:3b-instruct
LLM_SUMMARY_MODEL=ollama/qwen2.5:3b-instruct
LLM_API_BASE=http://127.0.0.1:11434
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_TEMPERATURE=0.3
LLM_FALLBACK_ENABLED=false
LLM_FALLBACK_MODEL=
LLM_FALLBACK_API_BASE=
LLM_FALLBACK_API_KEY=

# ---- Limits ----
MAX_USER_MESSAGE_CHARS=4000
MAX_ASSISTANT_CHARS=1200
MAX_SESSIONS_PER_USER=100
MAX_MESSAGES_PER_SESSION=200
SESSION_TTL_DAYS=30
MESSAGE_RETENTION_DAYS=30

# ---- Rate limits (design §12.7) ----
RATE_SESSION_CREATE_PER_MINUTE=10
RATE_MESSAGE_PER_MINUTE=20
RATE_GLOBAL_STREAMS=20
RATE_IP_STREAMS=2
RATE_UID_STREAMS=3

# ---- Docker Compose（compose 读取的变量；应用本身不读）----
# 基础 compose 用于端口绑定与索引挂载（design §13.2.1）
# CHAT_BIND_ADDR 与 INDEX_ARTIFACT_DIR 已在上方定义
#
# 本地 overlay（docker-compose.local.yml，design §13.2.2）时，把 .env 改成：
#   MYSQL_HOST=mysql
#   MYSQL_PASSWORD=<任意密码>
#   MYSQL_ROOT_PASSWORD=<root 密码>
#   LLM_PROVIDER=litellm                 # 镜像已含 litellm；不切则保持 mock
#   LLM_API_BASE=http://ollama:11434     # 可选；需要先 ollama pull 模型
#   EMBEDDING_PROVIDER=ollama            # 可选；ollama embedding 走 httpx，无额外依赖
#   EMBEDDING_API_BASE=http://ollama:11434
#
# 生产（只起 persona-chat、连主节点 MySQL）时：
#   MYSQL_HOST=<主节点私网IP>
#   DB_AUTO_CREATE=false  # 表结构由 `alembic upgrade head` 管理
